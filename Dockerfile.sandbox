FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

#gaia packages
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    scipy \
    sympy \
    mpmath \
    pyarrow \
    fastparquet \
    openpyxl \
    xlsxwriter \
    xlrd \
    pypdf \
    pdfplumber \
    python-docx \
    python-pptx \
    biopython \
    python-chess \
    pillow \
    opencv-python-headless \
    pydub \
    beautifulsoup4 \
    requests

