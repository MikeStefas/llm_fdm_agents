import random
from collections import Counter

def simulate_game(num_trials=10000):
    ejection_counts = Counter()
    
    for trial in range(num_trials):
        ramp = list(range(1, 101))
        platform = []
        
        if len(ramp) >= 3:
            platform = [ramp.pop(0), ramp.pop(0), ramp.pop(0)]
        
        while len(ramp) > 0 and len(platform) == 3:
            piston_pos = random.randint(1, 3)
            
            if piston_pos == 1:
                ejected_ball = platform[0]
                ejection_counts[ejected_ball] += 1
                
                new_platform = [platform[1], platform[2]] + [ramp.pop(0)] if len(ramp) > 0 else [platform[1], platform[2]]
                platform = new_platform
            
            elif piston_pos == 2:
                ejected_ball = platform[1]
                ejection_counts[ejected_ball] += 1
                
                new_platform = [platform[2]] + [ramp.pop(0), ramp.pop(0)] if len(ramp) >= 2 else [platform[2]] + ramp.copy()[:2] if len(ramp) >= 1 else [platform[2]] + [] 
                
                while len(new_platform) < 3 and len(ramp) > 0:
                    new_platform.append(ramp.pop(0))
                
                platform = new_platform
            
            elif piston_pos == 3:
                ejected_ball = platform[2]
                ejection_counts[ejected_ball] += 1
                
                new_platform = [platform[1]] + [ramp.pop(0), ramp.pop(0)] if len(ramp) >= 2 else [platform[1]] + ramp.copy()[:2] if len(ramp) >= 1 else [platform[1]] + [] 
                
                while len(new_platform) < 3 and len(ramp) > 0:
                    new_platform.append(ramp.pop(0))
                
                platform = new_platform
    
    return ejection_counts

