# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.5-9b

# FDM Configuration (OpenRouter)
FDM_MODEL=cloudflare/clef-flash
FDM_BASE_URL=https://openrouter.ai/api
FDM_API_KEY=your_openrouter_api_key_here

# TypeSafe SDK Configuration
TYPESAFE_API_KEY=your_typesafe_or_openrouter_api_key_here
TYPESAFE_BASE_URL=https://openrouter.ai/api
TYPESAFE_DEFAULT_MODEL=cloudflare/clef-flash

# Local llama.cpp / LM Studio Configuration (Optional)
LOCAL_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLAMACPP_MODEL=/path/to/your/model.gguf

